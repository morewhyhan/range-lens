{
  "id": "ANSWER_PROVENANCE_AND_GRADING_IDENTITY_CONTRACT_V1",
  "status": "paper_answer_identity_and_source_lineage_closed_runtime_package_missing",
  "purpose": "为每道题固定答案身份、可见标签、允许判分、字段来源和资料不足停止，防止权益或局部求解结果冒充完整GTO。",
  "sources": [
    "reference-course-policy-ledger-contract.json",
    "solver-snapshot-to-lesson-package.json",
    "solver-course-visual-compiler-contract.json",
    "strategy-to-course-compiler-contract.json",
    "session-question-queue-contract.json",
    "full-course-coverage-and-release-contract.json"
  ],
  "identities": [
    {
      "id": "fact",
      "userLabel": "牌面事实",
      "requiredBlocks": [
        "identity",
        "physical"
      ],
      "allowedOutputs": [
        "bestFive",
        "handClass",
        "improvementCards",
        "physicalFilter",
        "potOdds",
        "ledgerFormula"
      ],
      "forbiddenOutputs": [
        "referenceFrequency",
        "courseActionGrade"
      ],
      "grade": "independent_fact_or_formula",
      "sourceRule": "牌力评估器、实体组合枚举和明确公式；事实不选择下注动作。"
    },
    {
      "id": "demonstration",
      "userLabel": "示范讲解",
      "requiredBlocks": [
        "identity",
        "physical",
        "teaching"
      ],
      "allowedOutputs": [
        "declaredExample",
        "reasoningSkeleton",
        "parentReturn"
      ],
      "forbiddenOutputs": [
        "independent_mastery",
        "targetStrategyClaim"
      ],
      "grade": "demonstration_only",
      "sourceRule": "局部课程例子可用于展示结构，但不能作为未见题精确策略答案。"
    },
    {
      "id": "course_rule",
      "userLabel": "本课程规则",
      "requiredBlocks": [
        "identity",
        "physical",
        "course",
        "difference",
        "teaching"
      ],
      "allowedOutputs": [
        "courseDecision",
        "courseAmount",
        "courseRangeAfter",
        "courseSuccessorOrStop"
      ],
      "forbiddenOutputs": [
        "rawGTOClaim",
        "unlabeledReferenceFrequency"
      ],
      "grade": "declared_course_policy_only",
      "sourceRule": "必须有版本化课程政策和简化差异账本；政策缺失就停止。"
    },
    {
      "id": "reference_frequency",
      "userLabel": "参考频率",
      "requiredBlocks": [
        "identity",
        "physical",
        "reference"
      ],
      "allowedOutputs": [
        "referenceActionFrequencyByCombo",
        "referenceActionValueByCombo"
      ],
      "forbiddenOutputs": [
        "courseDecision",
        "learnerMastery"
      ],
      "grade": "reference_frequency_display_only",
      "sourceRule": "必须有匹配输入指纹、固定求解快照、动作菜单和质量证据；频率不是课程动作。"
    },
    {
      "id": "reference_policy",
      "userLabel": "匹配参考策略",
      "requiredBlocks": [
        "identity",
        "physical",
        "reference",
        "course",
        "difference",
        "range",
        "successor",
        "teaching"
      ],
      "allowedOutputs": [
        "referencePolicy",
        "referenceRangeAfter",
        "differenceLedger",
        "legalSuccessors"
      ],
      "forbiddenOutputs": [
        "unmatchedSolverClaim",
        "equityAsAction"
      ],
      "grade": "matched_reference_and_course_policy",
      "sourceRule": "输入配置、范围、行动菜单、求解快照和后继全部匹配后才可开放。"
    },
    {
      "id": "not_open",
      "userLabel": "资料不足，暂不开放",
      "requiredBlocks": [
        "identity"
      ],
      "allowedOutputs": [
        "stopReason",
        "returnToParent",
        "missingField"
      ],
      "forbiddenOutputs": [
        "zeroFrequency",
        "defaultFold",
        "inventedRange",
        "inventedSuccessor"
      ],
      "grade": "unknown_is_error_and_stop",
      "sourceRule": "缺身份、政策、范围、后继或许可证时，显示停止卡，不生成动作答案。"
    }
