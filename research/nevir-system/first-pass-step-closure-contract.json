    "p2_board": {"principle":"先从实体牌得到最佳五张和牌力，再看未来改善","factInputs":["heroCards","board","bestFive","improvementCards"],"visual":"hero_cards_board_best_five_and_rank_ladder","practiceSequence":["name_cards","choose_best_five","classify_hand","mark_improvements"],"contrastAxis":"one_board_card_or_one_hole_card","transferAxis":"one_board_card","minimumIndependentOutput":["bestFive","handCategory","improvementCards"],"sourceBoundary":"fact_only_until_strategy_reference_exists"},
