    "p6_update": {"principle":"保留旧状态，只重新计算回应或新牌改变的一个字段","factInputs":["previousSnapshot","responseOrCard","changedField","rangeAfter","ledger","successor"],"visual":"single_field_delta_with_successor_card","practiceSequence":["restore_snapshot","identify_one_change","update_range_or_ledger","open_successor_or_stop"],"contrastAxis":"opponent_response_vs_new_card","transferAxis":"one_response_or_card_field","minimumIndependentOutput":["changedField","updatedRangeOrLedger","successorOrStop"],"sourceBoundary":"missing_successor_stops_at_current_parent"},
    "p7_close": {"principle":"把最终结果和当时决定分开，并把结构带到下一题","factInputs":["settlement","decisionSnapshot","errorLayer","routeSummary","transferField"],"visual":"settlement_ledger_and_route_replay","practiceSequence":["settle","separate_result_from_decision","classify_error","recall_route","state_transfer"],"contrastAxis":"same_decision_different_result","transferAxis":"one_field_in_new_parent_frame","minimumIndependentOutput":["settlement","decisionReview","errorLayer","nextEntry"],"sourceBoundary":"settlement_never_infers_strategy"}
  },
  "steps": [
    {"id":"p1_context","entryRequires":["table","street","history"],"userSees":["six_max_table","action_line","pot_and_stacks"],"oneQuestion":"谁在行动、发生了什么、现在要多少钱？","teacherSentence":"先把人、动作和钱摆清楚，再谈牌。","primaryOutput":["actor","history","pot","stack","toCall"],"handoff":["seat","actor","history","potBB","stacksBB","toCallBB"],"childPolicy":"open_action_order_or_ledger_only","errorReturn":"p1_context","closureCheck":"state_can_be_repeated_without_guessing_strategy","stopRule":"missing_history_or_money_stops_at_context"},
    {"id":"p2_board","entryRequires":["p1_handoff","heroHole","board"],"userSees":["hero_cards","board","best_five_candidates","improvement_cards"],"oneQuestion":"自己现在是什么牌，哪些牌会改善？","teacherSentence":"先认出自己现在的牌，再看未来会怎么变。","primaryOutput":["bestFive","handClass","draws","improvementCards"],"handoff":["bestFive","handCategory","draws","improvementCards"],"childPolicy":"open_best_five_or_hand_rank_only","errorReturn":"p2_board","closureCheck":"best_five_and_improvement_are_identified","stopRule":"illegal_or_ambiguous_cards_stop_at_board"},
