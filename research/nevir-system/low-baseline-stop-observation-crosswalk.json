  "observationFieldRegistry": {
    "firstAnswer": {
      "channel": "language",
      "timing": "before_help",
      "meaning": "用户第一次自己给出的回答或明确不知道。"
    },
    "currentLayerSelfLocated": {
      "channel": "memory",
      "timing": "before_help",
      "meaning": "用户自己指出当前路线停点。"
    },
    "visualAnchorPointed": {
      "channel": "visual",
      "timing": "before_help",
      "meaning": "用户指出本停点的中心视觉锚点。"
    },
    "primaryActionCompleted": {
      "channel": "operation",
      "timing": "after_answer",
      "meaning": "用户完成本停点唯一主要动作。"
    },
    "nextLayerSelfLocated": {
      "channel": "memory",
      "timing": "after_answer",
      "meaning": "非终点停点中用户自己找到下一层。"
    },
    "nextOrStopSelfLocated": {
      "channel": "memory",
      "timing": "after_answer",
      "meaning": "用户自己找到下一停点，或在终点说出停止。"
    },
    "returnPointSelfLocated": {
      "channel": "memory",
      "timing": "after_answer",
      "meaning": "用户自己指出答错或关闭子层后回到哪里。"
    },
    "handoffRestated": {
      "channel": "memory",
      "timing": "after_answer",
      "meaning": "用户用自己的话复述交给下一层的字段。"
    },
    "hostPromptCount": {
      "channel": "language",
      "timing": "throughout",
      "meaning": "主持者在首答前后的提示次数。"
    },
    "hostPromptContent": {
      "channel": "language",
      "timing": "throughout",
      "meaning": "提示属于重复问题、指向事实、指向标记、揭示事实还是引导答案。"
    },
    "errorLayer": {
      "channel": "operation",
      "timing": "after_error",
      "meaning": "错误归因到哪一层；未知也要记录。"
    },
    "parentRestore": {
      "channel": "memory",
      "timing": "after_child_close_or_error",
      "meaning": "回到父帧并恢复父帧字段。"
    },
    "changedField": {
      "channel": "visual",
      "timing": "transfer_only",
      "meaning": "迁移题中唯一改变的字段。"
    },
    "retryWithoutRouteReset": {
      "channel": "operation",
      "timing": "after_error",
      "meaning": "错误后能在原路线继续，而不是被迫重新开始。"
    },
    "exitPoint": {
      "channel": "operation",
      "timing": "terminal_or_stop",
      "meaning": "用户退出、停止或完成的位置。"
    }
  },
