{
  "id": "UNIT_FIELD_COMPLETION_QUEUE_V1",
  "status": "queue_compiled_from_audit_not_released",
  "purpose": "把35项从当前字段缺口按依赖顺序补齐，禁止先写动作答案再回填身份、范围或后继。",
  "sourceDocuments": [
    "unit-execution-field-audit.json",
    "unit-identity-normalization-candidate.json",
    "unit-outcome-matrix.json",
    "course-unit-field-schema-map.json",
    "first-pass-representative-units.json"
  ],
  "phaseOrder": [
    {
      "id": "identity_source",
      "fields": [
        "street",
        "role",
        "actionState"
      ],
      "purpose": "只补来源明确的街次、角色、行动状态和位置身份",
      "stop": "身份缺失时停在identity_only_not_practice_ready"
    },
    {
      "id": "identity_canonical",
      "fields": [
        "street",
        "role",
        "actionState"
      ],
      "purpose": "把已核对的sourceScopedIdentity迁移到规范字段",
      "stop": "迁移失败时保留source_local_context，不开放策略"
    },
    {
      "id": "fact_frame",
      "fields": [
        "factInputs",
        "sourceIdentity"
      ],
      "purpose": "冻结牌、钱、历史、合法性和来源指纹",
      "stop": "事实或来源不一致时降级为fact"
    },
    {
      "id": "course_policy",
      "fields": [
        "coursePolicy"
      ],
      "purpose": "单独声明课程简化和答案身份",
      "stop": "没有课程规则时不生成course_policy题"
    },
    {
      "id": "reference_policy",
      "fields": [
        "referencePolicy"
      ],
      "purpose": "取得同条件参考策略、EV、动作频率和版本指纹",
      "stop": "没有匹配参考时不开放精确策略判分"
    },
    {
      "id": "range_snapshots",
      "fields": [
        "rangeBefore",
        "rangeAfter"
      ],
      "purpose": "保存固定视角、固定分母的动作前后范围",
      "stop": "没有逐手权重或分母时只开放物理事实"
    },
    {
      "id": "successors",
      "fields": [
        "legalSuccessors"
      ],
      "purpose": "闭合回应、新牌、终局和账本后继",
      "stop": "缺后继时停在当前父帧"
    },
    {
      "id": "teaching_transfer",
      "fields": [
        "explanation",
        "transferVariant"
      ],
      "purpose": "补当前层解析、一个改变和一个保持对照",
      "stop": "未见变体未冻结时不开放independent_candidate"
    },
    {
      "id": "release",
      "fields": [
        "releaseStatus"
      ],
      "purpose": "写明fact、demonstration、course_policy或reference_policy身份",
      "stop": "发布身份不明确时not_open"
    }
  ],
  "groupOrder": [
    "compare.unopened",
    "compare.bet",
    "compare.raise",
    "update.response",
    "update.card"
  ],
  "firstPassRule": {
    "representativePerGroup": 1,
    "representatives": {
      "compare.unopened": "1.5",
      "compare.bet": "2.1",
      "compare.raise": "3.1",
      "update.response": "4.5",
      "update.card": "5.7"
    },
    "fullQueueAfter": [
      "order_recall",
      "layer_location",
      "error_recovery",
      "one_variable_transfer"
    ],
    "flatHomeMenuForbidden": true
  },
