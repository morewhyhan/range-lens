  "evidenceStages": [
    {
      "id": "T0_structure",
      "requires": [
        "firstPassCompleted",
        "outerInnerRecall",
        "errorRecovery",
        "singleFieldTransfer"
      ],
      "proves": "路线结构证据",
      "cannotProve": [
        "strategyAccuracy",
        "NL50Readiness"
      ]
    },
    {
      "id": "T1_matched_course_package",
      "requires": [
        "targetConfigFrozen",
        "matchedInputFingerprint",
        "coursePolicyLedger",
        "rangeAndSuccessor"
      ],
      "proves": "指定课程配置下的课包可判分",
      "cannotProve": [
        "learnerMastery",
        "NL50Readiness"
      ]
    },
    {
      "id": "T2_heldout_execution",
      "requires": [
        "unexposedCases",
        "dedupeByStructure",
        "firstAnswerBeforeHelp",
        "allScoreDimensions"
      ],
      "proves": "未曝光题中的可执行表现",
      "cannotProve": [
        "realTableWinRate",
        "universalNL50"
      ]
    },
    {
      "id": "T3_independent_review",
      "requires": [
        "frozenPackage",
        "independentReconstruction",
        "differenceLedgerReview",
        "unknownNodesReported"
      ],
      "proves": "答案和来源可以被外部复核",
      "cannotProve": [
        "longTermProfitability"
      ]
    },
    {
      "id": "T4_real_decision_audit",
      "requires": [
        "coveredConfigurationOnly",
        "decisionLog",
        "helpAndUnknownLog",
        "longitudinalSample",
        "externalBenchmark"
      ],
      "proves": "已覆盖配置下的真实决策表现",
      "cannotProve": [
        "uncoveredSpots",
        "guaranteedProfit"
      ]
    }
  ],
  "holdoutRules": {
    "freezeBeforeScoring": true,
    "noTrainingCasesInHoldout": true,
    "firstAnswerBeforeHelp": true,
    "dedupeByStructureAndSource": true,
    "doNotCountSameCaseRetryAsIndependent": true,
    "exactlyOneChangedFieldForTransfer": true,
    "reportUnknownAndInvalidSeparately": true,
    "strataMustBeDeclared": [
      "parentState",
      "unitGroup",
      "street",
      "actionState",
      "boardClass",
      "handClass",
      "edgeOrInternal",
      "answerIdentity"
    ],
    "noGlobalAveragePromotion": true
  },
  "externalReview": {
    "reviewerRebuildsFromInput": true,
    "reviewerSeesFrozenVersionAndHashes": true,
    "reviewerChecksDifferenceLedger": true,
    "reviewerChecksUnknownStops": true,
    "reviewerCannotUseLearnerOutcomeToChangeAnswerKey": true
  },
  "realDecisionAudit": {
    "coveredConfigurationOnly": true,
    "recordFields": [
      "timestamp",
      "configurationFingerprint",
      "caseIdentity",
      "firstAnswer",
      "helpUse",
      "unknownStop",
      "decision",
      "amount",
      "rangeOrStop",
      "successorOrStop",
      "resultSeparateFromDecision"
    ],
    "outcomeIsNotDecisionGrade": true,
    "minimumSampleSize": null,
    "threshold": null,
    "calibrationRequired": true,
    "uncoveredSpotsRemainUnknown": true
  },
  "forbiddenSubstitutions": [
    "docs_or_green_tests_equal_NL50",
    "training_accuracy_equal_real_win_rate",
    "short_term_profit_equal_strategy_mastery",
