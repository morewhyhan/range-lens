      "caseIdentity",
      "seenOrHeldout",
      "parentStep",
      "unitId",
      "sourceIdentity",
      "answerIdentity",
      "inputFingerprint",
      "frameRecords",
      "eventLog",
      "scoreVector",
      "releaseDecision",
      "clearedOnClose"
    ],
    "frameRecord": [
      "frameId",
      "routeIndex",
      "parentStep",
      "caseId",
      "seenOrHeldout",
      "firstAnswer",
      "firstAnswerAt",
      "helpLevelBeforeAnswer",
