{
  "id": "SESSION_EVIDENCE_AND_TARGET_REPORT_CONTRACT_V1",
  "status": "paper_session_evidence_and_target_report_schema_written_runtime_and_trials_missing",
  "purpose": "把一次练习的观察、判分、错误回退、单变量迁移、连续路线和目标级汇总统一为临时会话证据；不建立数据库、不把帮助后的改正覆盖首答，也不把一次成绩或牌局输赢当成NL50证明。",
  "sources": [
    "unified-learner-evidence-release-gates.json",
    "target-readiness-and-nl50-benchmark-contract.json",
    "low-baseline-stop-observation-crosswalk.json",
    "first-pass-user-facing-script-contract.json",
    "200_低基础逐停点观察与四通道证据交叉合同.md",
    "207_目标级准备度与NL50基准证据合同.md"
  ],
  "sessionRecord": {
