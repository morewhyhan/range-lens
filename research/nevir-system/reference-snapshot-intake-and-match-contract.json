{
  "id": "REFERENCE_SNAPSHOT_INTAKE_AND_MATCH_CONTRACT_V1",
  "status": "paper_reference_intake_schema_and_repo_role_boundaries_missing_matched_snapshot",
  "purpose": "把外部仓库的事实、参考策略、界面参考和算法实验分开，并要求每一份可教学结果先冻结来源与输入指纹，再经过逐组合、独立复算、课程编译和后继闭合，最后才进入静态课包。",
  "sources": [
    "external-repo-current-capability-report.json",
    "repository-capabilities-evidence.json",
    "solver-snapshot-to-lesson-package.json",
    "answer-provenance-and-grading-identity-contract.json",
    "solver-course-visual-compiler-contract.json",
    "176_指定仓库当前公开能力与训练器映射报告.md",
    "114_A72完整参考获取与验收规格.md"
  ],
  "sourceRoles": {
    "gto-wizard/equity-calculator": {
      "layer": "fact_equity",
      "allowed": [
        "exact_runout_enumeration",
        "win",
        "tie",
        "pot_share_equity",
        "dead_cards"
      ],
      "cannotBecome": [
        "weighted_range",
        "action_frequency",
        "bet_size",
        "action_ev",
        "successor_policy"
      ],
      "releaseRole": "fact_only"
    },
    "b-inary/holdem-hand-evaluator": {
      "layer": "fact_hand_rank",
      "allowed": [
        "best_five",
        "hand_category",
        "showdown_order"
      ],
      "cannotBecome": [
        "range_policy",
        "action_frequency",
        "action_ev",
        "course_answer"
      ],
      "releaseRole": "fact_only"
    },
    "b-inary/postflop-solver": {
      "layer": "reference_strategy",
      "allowed": [
        "per_combo_strategy",
        "action_ev",
        "equity",
        "reach_weights",
        "range_after",
        "successor_identity"
      ],
      "cannotBecome": [
        "course_policy",
        "beginner_mastery",
        "nl50_readiness"
      ],
      "releaseRole": "offline_reference_only"
    },
    "b-inary/wasm-postflop": {
      "layer": "browser_solver_shell",
      "allowed": [
        "worker_input_shape",
        "node_navigation_reference",
        "range_view_reference"
      ],
      "cannotBecome": [
        "training_route",
        "grading_policy",
        "learner_mastery"
      ],
      "releaseRole": "ui_reference_only"
    },
    "b-inary/desktop-postflop": {
      "layer": "desktop_solver_shell",
      "allowed": [
        "desktop_node_navigation",
        "combo_view_reference",
        "range_chart_reference"
      ],
      "cannotBecome": [
        "training_route",
        "course_policy",
        "nl50_readiness"
      ],
      "releaseRole": "ui_reference_only"
    },
    "b-inary/poker-cfr": {
      "layer": "algorithm_test_reference",
      "allowed": [
        "small_game_cfr_regression",
        "algorithm_comparison"
      ],
      "cannotBecome": [
        "complete_postflop_reference",
        "course_answer",
        "target_benchmark"
      ],
      "releaseRole": "research_only"
    }
  },
  "identityFields": [
    "sourceRepo",
    "sourceCommit",
    "sourceTreeHash",
    "license",
    "licenseReview",
    "buildFeatures",
    "gameType",
    "tableSize",
    "activePlayers",
    "seatMap",
    "positionModel",
    "effectiveStackBB",
    "rakeModel",
    "anteOrBlindStructure",
    "street",
    "history",
    "board",
    "deadCards",
    "rangesByPlayer",
    "startingPotBB",
    "actionMenu",
    "raiseSizes",
    "donkSizes",
    "allInThresholds",
    "bunching",
    "nodeLocking",
    "storageMode",
    "inputFingerprint"
  ],
  "stages": [
    {
      "id": "I0_provenance",
      "question": "这份结果到底来自哪一个仓库、提交、构建和许可证？",
      "requires": [
        "sourceRepo",
        "sourceCommit",
        "sourceTreeHash",
        "license",
        "licenseReview",
        "buildFeatures"
      ],
      "output": "sourceIdentity",
      "blocks": [
        "all_distribution",
        "matched_reference"
      ]
    },
    {
      "id": "I1_problem_identity",
      "question": "求解的游戏、牌面、范围、筹码和动作菜单是否与课程完全相同？",
      "requires": [
        "gameType",
        "tableSize",
        "activePlayers",
        "seatMap",
        "positionModel",
        "effectiveStackBB",
        "rakeModel",
        "anteOrBlindStructure",
        "street",
        "history",
        "board",
        "deadCards",
        "rangesByPlayer",
        "startingPotBB",
        "actionMenu",
        "raiseSizes",
        "donkSizes",
        "allInThresholds",
        "bunching",
        "nodeLocking",
        "storageMode",
        "inputFingerprint"
      ],
      "output": "inputFingerprint",
      "blocks": [
        "strategy_grading",
        "course_release"
      ]
    },
    {
      "id": "I2_raw_strategy",
      "question": "每个真实节点是否有逐组合的动作、频率、EV和质量信息？",
      "requires": [
        "nodeIdentity",
        "privateCards",
        "weights",
        "normalizedWeights",
        "availableActions",
        "strategy",
        "equity",
        "expectedValues",
        "quality"
      ],
      "output": "referenceSnapshot",
      "blocks": [
        "action_grading",
        "range_after"
      ]
    },
    {
      "id": "I3_independent_recompute",
      "question": "物理牌力、合法行动、组合分母、局部动作后范围和终结结果能否独立复算？",
      "requires": [
        "bestFive",
        "legalActions",
        "fixedDenominator",
        "rangeAfterFormula",
        "settlementCheck",
        "qualityCheck"
      ],
      "output": "independentChecks",
      "blocks": [
        "reference_release"
      ]
    },
    {
      "id": "I4_course_compile",
      "question": "课程究竟删掉、合并或量化了什么，和原始参考差多少？",
      "requires": [
        "coursePolicy",
        "quantizationRule",
        "differenceLedger",
        "policyLoss",
        "scope"
      ],
      "output": "coursePackage",
      "blocks": [
        "course_answer"
      ]
    },
    {
      "id": "I5_successor_closure",
      "question": "动作以后下一节点、下一范围和停点是否真实存在并且可以继续？",
      "requires": [
        "successorIdentityOrStopReason",
        "expandedChanceCards",
        "nextRangeStateOrStop",
        "ledgerHandoff"
      ],
      "output": "successorGraph",
      "blocks": [
        "continuous_practice",
        "three_street_claim"
      ]
    },
    {
      "id": "I6_static_release",
      "question": "学习者看到的每一个答案能否回到来源、政策和停止原因？",
      "requires": [
        "inputFingerprint",
        "sourceIdentity",
        "factSnapshot",
        "referenceSnapshot",
        "coursePolicy",
        "differenceLedger",
        "rangeSnapshots",
        "successorGraph",
        "lessonFrames",
        "releaseDecision"
      ],
      "output": "verifiedStaticLessonPackage",
      "blocks": [
        "runtime_training",
        "nl50_evidence"
      ]
    }
  ],
  "perComboRequired": [
    "nodeIdentity",
    "privateCards",
    "physicalWeight",
    "referenceActionFrequencyByCombo",
    "referenceActionValueByCombo",
    "referenceEquityByCombo",
    "reachWeight",
    "referenceAfterByAction",
    "courseAfterByAction",
    "differenceReasonByAction",
    "successorIdentityByAction",
    "sourceFingerprint"
  ],
  "matchRules": {
    "exactFieldEquality": true,
    "canonicalJsonBeforeHash": true,
    "actionAmountIncludedInFingerprint": true,
    "rangesAndWeightsIncludedInFingerprint": true,
    "activePlayersSeparatedFromBunching": true,
    "isomorphicChanceExpandedBeforeDisplay": true,
    "unknownReferenceIsNotZero": true,
    "missingSuccessorStopsAtParent": true,
    "localCaseCannotFillMatchedReference": true,
    "neighboringBoardCannotFillTargetNode": true,
    "equityCannotSelectAction": true,
    "solverOutputCannotBecomeCoursePolicyAutomatically": true
  },
  "releaseIdentities": [
    {
      "id": "fact_only",
      "permits": [
        "p2_board",
        "physical_filter"
      ],
      "grade": "fact_check_only"
    },
    {
      "id": "demonstration",
      "permits": [
        "teacher_walkthrough",
        "visual_example"
      ],
      "grade": "no_exact_strategy_grade"
    },
    {
      "id": "course_policy",
      "permits": [
        "simplified_practice"
      ],
      "grade": "course_policy_only"
    },
    {
      "id": "matched_reference",
      "permits": [
        "exact_strategy_practice",
        "range_after",
        "successor"
      ],
      "grade": "reference_and_course_checked"
    },
    {
      "id": "not_open",
      "permits": [
        "stop_card"
      ],
      "grade": "no_answer_key"
    }
  ],
  "matchingAlgorithm": {
    "canonicalObject": "ordered JSON with explicit nulls, normalized cards, normalized action amounts and sorted weighted combinations",
    "fingerprint": "sha256(canonicalJson(identityFields))",
    "matchDecision": "all identityFields equal and source quality gates passed; one mismatch means unmatched",
    "comparisonReport": [
      "field",
      "expected",
      "received",
      "classification",
      "blocks"
    ],
    "classifications": [
      "exact_match",
      "config_mismatch",
      "source_unverified",
      "quality_insufficient",
      "unknown"
    ]
  },
  "staticPackageMinimum": [
    "sourceIdentity",
    "inputFingerprint",
    "factSnapshot",
    "referenceSnapshot",
    "coursePolicy",
    "differenceLedger",
    "rangeSnapshots",
    "successorGraph",
    "lessonFrames",
    "releaseDecision"
  ],
  "stopCards": [
    {
      "id": "S0_source",
      "when": "来源提交、许可证或构建特征缺失",
      "userText": "资料来源还没有核对，先停在资料层。",
      "returnTo": "author_reference_intake"
    },
    {
      "id": "S1_mismatch",
      "when": "目标配置任意字段不一致",
      "userText": "这份参考和当前牌局设置不一样，不能拿来判动作。",
      "returnTo": "p1_context"
    },
    {
      "id": "S2_missing_action_after",
      "when": "没有逐动作的动作后范围",
      "userText": "这里只能看动作频率，不能练动作后范围。",
      "returnTo": "p6_update"
    },
    {
      "id": "S3_missing_successor",
      "when": "后继节点或停止原因缺失",
      "userText": "这里没有可靠的下一步，先停在当前节点。",
      "returnTo": "p6_update"
    },
    {
      "id": "S4_license",
      "when": "许可证未核对或不允许分发",
      "userText": "这份资料只能做研究参考，不能直接打包进软件。",
      "returnTo": "author_source_review"
    }
  ],
  "currentEvidence": {
    "repoRoleMapAudited": true,
    "identitySchemaWritten": true,
    "fingerprintAlgorithmWritten": true,
    "perComboCompletenessWritten": true,
    "independentRecomputeContractWritten": true,
    "courseDifferenceContractLinked": true,
    "matchedSnapshot": false,
    "sourceLicenseReleaseReview": false,
    "staticPackageReleased": false,
    "runtimeTrainingIntegrated": false,
    "learnerTrial": false,
    "nl50Evidence": false
  },
  "guards": {
    "equityDoesNotImplyAction": true,
    "handEvaluatorDoesNotImplyPolicy": true,
    "uiReferenceDoesNotImplyTraining": true,
    "sixMaxBunchingDoesNotImplySixActivePlayers": true,
    "noMatchMeansNoExactGrade": true,
    "noSuccessorMeansNoContinuousClaim": true,
    "noLicenseReviewMeansNoDistribution": true,
    "noPaperContractEqualsRuntime": true
  }
}
